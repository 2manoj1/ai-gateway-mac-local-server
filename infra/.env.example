POSTGRES_DB=aigateway
POSTGRES_USER=aigateway
POSTGRES_PASSWORD=change-me-later

POSTGRES_PORT=5432
QDRANT_PORT=6333
REDIS_PORT=6379

# Production publishes only the gateway on localhost for Cloudflare Tunnel.
# PostgreSQL, Redis, and Qdrant are bound to localhost only.
GATEWAY_PORT=8000
ADMIN_SECRET=sk-admin-secret-change-me
OLLAMA_BASE_URL=http://host.containers.internal:11434/v1
OLLAMA_WARMUP_ON_STARTUP=true
OLLAMA_KEEP_ALIVE=-1
OLLAMA_CHAT_CONCURRENCY_LIMIT=10
OLLAMA_CHAT_ACQUIRE_TIMEOUT_SECONDS=0.25
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_HTTP_MAX_CONNECTIONS=20
OLLAMA_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
# Recommended local model set:
# - DEFAULT_MODEL=qwen3.5:9b for main chat, tool calls, and agent workflows.
# - gemma4:e4b as an alternate daily assistant/vision-capable model.
# - llama3.2 as a small fast fallback model.
# - nomic-embed-text for embeddings/RAG requests.
DEFAULT_MODEL=qwen3.5:9b
RUN_MIGRATIONS=1
